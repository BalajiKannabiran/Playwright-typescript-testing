{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly Playwright TypeScript automation framework for the EA Employee application.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
